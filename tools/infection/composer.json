{
    "name": "jbboehr/phpstan-laravel-validation-infection-tooling",
    "description": "Isolated Infection toolchain for phpstan-laravel-validation",
    "type": "project",
    "license": "AGPL-3.0-or-later",
    "require": {
        "php": "^8.3",
        "infection/infection": "^0.34.1"
    },
    "scripts": {
        "post-install-cmd": "@php patch-interceptor.php",
        "post-update-cmd": "@php patch-interceptor.php",
        "test": "@php tests/interceptor.php"
    },
    "config": {
        "allow-plugins": {
            "infection/extension-installer": true
        },
        "platform": {
            "php": "8.3.0"
        },
        "sort-packages": true
    }
}
