+<?php
+
+declare(strict_types=1);
+
+use function PHPStan\Testing\assertType;
+
+use Pterodactyl\Http\Requests\Api\Remote\ReportBackupCompleteRequest;
+use Pterodactyl\Tests\Fixtures\ExperimentalValidation\MixedModeRequest;
+use Pterodactyl\Tests\Fixtures\ExperimentalValidation\MissingModeRequest;
+use Pterodactyl\Tests\Fixtures\ExperimentalValidation\PresentModeRequest;
+use Pterodactyl\Http\Requests\Api\Application\Nodes\GetDeployableNodesRequest;
+
+function experimentalValidationContracts(
+    PresentModeRequest $present,
+    MissingModeRequest $missing,
+    MixedModeRequest $mixed,
+    GetDeployableNodesRequest $parsed,
+    ReportBackupCompleteRequest $natural,
+): void {
+    assertType("array{mode: 'create', value: string}", $present->validated());
+    assertType('array{value: string}', $present->safe()->only(['value']));
+    assertType("array{mode: 'create', retained: string}", $missing->validated());
+    assertType('array{}', $missing->safe()->only(['value']));
+    assertType("array{mode: 'create'|'update', value?: string}", $mixed->validated());
+    assertType('mixed', $present->input('value'));
+    assertType('int', $parsed->validated('memory'));
+    assertType('int', $parsed->validated('disk'));
+    assertType('array{memory: int, disk: int}', $parsed->safe()->only(['memory', 'disk']));
+    assertType("array{successful: 0|1|'0'|'1'|bool}", $natural->safe()->only(['successful']));
+    assertType('array{checksum?: string|null}', $natural->safe()->only(['checksum']));
+}
