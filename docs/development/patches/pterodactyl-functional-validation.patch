diff --git a/tests/Integration/ParsingAdoptionTest.php b/tests/Integration/ParsingAdoptionTest.php
new file mode 100644
index 0000000..7d7ea88
--- /dev/null
+++ b/tests/Integration/ParsingAdoptionTest.php
@@ -0,0 +1,214 @@
+<?php
+
+namespace Pterodactyl\Tests\Integration;
+
+use Pterodactyl\Models\User;
+use Pterodactyl\Models\ApiKey;
+use Illuminate\Foundation\Application;
+use Illuminate\Contracts\Console\Kernel;
+use Illuminate\Foundation\Http\FormRequest;
+use Illuminate\Foundation\Testing\TestCase;
+use Illuminate\Validation\ValidationException;
+use PHPUnit\Framework\Attributes\DataProvider;
+use Pterodactyl\Http\Requests\Api\Remote\ReportBackupCompleteRequest;
+use Pterodactyl\Tests\Fixtures\ExperimentalValidation\MixedModeRequest;
+use Pterodactyl\Tests\Fixtures\ExperimentalValidation\MissingModeRequest;
+use Pterodactyl\Tests\Fixtures\ExperimentalValidation\PresentModeRequest;
+use Pterodactyl\Http\Requests\Api\Application\Nodes\GetDeployableNodesRequest;
+
+final class ParsingAdoptionTest extends TestCase
+{
+    public function createApplication(): Application
+    {
+        $app = require dirname(__DIR__, 2) . '/bootstrap/app.php';
+        $app->make(Kernel::class)->bootstrap();
+
+        return $app;
+    }
+
+    /** @return iterable<string, array{array<string, mixed>, array<string, mixed>}> */
+    public static function acceptedCriteria(): iterable
+    {
+        yield 'query strings and wildcard values' => [
+            ['memory' => '1024', 'disk' => '2048', 'location_ids' => ['4', 6]],
+            ['memory' => 1024, 'disk' => 2048, 'location_ids' => [4, 6]],
+        ];
+        yield 'zero limits and omitted locations' => [
+            ['memory' => '0', 'disk' => '0'],
+            ['memory' => 0, 'disk' => 0],
+        ];
+        yield 'blank optional locations remain a string' => [
+            ['memory' => '1', 'disk' => '1', 'location_ids' => ''],
+            ['memory' => 1, 'disk' => 1, 'location_ids' => ''],
+        ];
+        yield 'native integers and empty locations' => [
+            ['memory' => 1024, 'disk' => 2048, 'location_ids' => []],
+            ['memory' => 1024, 'disk' => 2048, 'location_ids' => []],
+        ];
+        yield 'page remains unparsed' => [
+            ['page' => '2', 'memory' => '1024', 'disk' => '2048'],
+            ['page' => '2', 'memory' => 1024, 'disk' => 2048],
+        ];
+    }
+
+    #[DataProvider('acceptedCriteria')]
+    public function testValidatedDeploymentCriteriaAreTypedAndInputIsPreserved(array $input, array $expected): void
+    {
+        $request = $this->validatedRequest($input);
+
+        self::assertSame($expected, $request->validated());
+        self::assertSame($expected['memory'], $request->validated('memory'));
+        self::assertSame(['memory' => $expected['memory']], $request->safe()->only(['memory']));
+        self::assertSame($input, $request->all());
+        self::assertSame($input['memory'], $request->input('memory'));
+    }
+
+    /** @return iterable<string, array{array<string, mixed>, string}> */
+    public static function rejectedCriteria(): iterable
+    {
+        yield 'missing memory' => [['disk' => '1'], 'memory'];
+        yield 'missing disk' => [['memory' => '1'], 'disk'];
+        yield 'negative memory' => [['memory' => '-1', 'disk' => '1'], 'memory'];
+        yield 'negative disk' => [['memory' => '1', 'disk' => '-1'], 'disk'];
+        yield 'plus sign' => [['memory' => '+1', 'disk' => '1'], 'memory'];
+        yield 'padded input' => [['memory' => ' 1', 'disk' => '1'], 'memory'];
+        yield 'fractional input' => [['memory' => '1.5', 'disk' => '1'], 'memory'];
+        yield 'native float' => [['memory' => 1.0, 'disk' => '1'], 'memory'];
+        yield 'native boolean' => [['memory' => true, 'disk' => '1'], 'memory'];
+        yield 'invalid location' => [['memory' => '1', 'disk' => '1', 'location_ids' => ['oops']], 'location_ids.0'];
+        yield 'padded location' => [['memory' => '1', 'disk' => '1', 'location_ids' => [' 4']], 'location_ids.0'];
+        yield 'blank location element' => [['memory' => '1', 'disk' => '1', 'location_ids' => ['']], 'location_ids.0'];
+        yield 'non-array locations' => [['memory' => '1', 'disk' => '1', 'location_ids' => '4'], 'location_ids'];
+    }
+
+    #[DataProvider('rejectedCriteria')]
+    public function testRejectsInvalidOrNonCanonicalDeploymentCriteria(array $input, string $field): void
+    {
+        try {
+            $this->validatedRequest($input);
+            self::fail('Invalid deployment criteria were accepted.');
+        } catch (ValidationException $exception) {
+            self::assertArrayHasKey($field, $exception->errors());
+        }
+    }
+
+    /** @return iterable<string, array{class-string<FormRequest>, array<string, mixed>, array<string, mixed>}> */
+    public static function acceptedExperimentalRequests(): iterable
+    {
+        yield 'definite presence' => [
+            PresentModeRequest::class,
+            ['mode' => 'create', 'value' => 'chosen', 'extra' => 'discarded'],
+            ['mode' => 'create', 'value' => 'chosen'],
+        ];
+        yield 'present permits an empty string' => [
+            PresentModeRequest::class,
+            ['mode' => 'create', 'value' => ''],
+            ['mode' => 'create', 'value' => ''],
+        ];
+        yield 'definite absence preserves later siblings' => [
+            MissingModeRequest::class,
+            ['mode' => 'create', 'retained' => 'keep'],
+            ['mode' => 'create', 'retained' => 'keep'],
+        ];
+        yield 'mixed domain matching branch' => [
+            MixedModeRequest::class,
+            ['mode' => 'create', 'value' => 'chosen'],
+            ['mode' => 'create', 'value' => 'chosen'],
+        ];
+        yield 'mixed domain nonmatching omission' => [
+            MixedModeRequest::class,
+            ['mode' => 'update'],
+            ['mode' => 'update'],
+        ];
+        yield 'mixed domain nonmatching value' => [
+            MixedModeRequest::class,
+            ['mode' => 'update', 'value' => 'optional'],
+            ['mode' => 'update', 'value' => 'optional'],
+        ];
+        yield 'failed backup omits conditional metadata' => [
+            ReportBackupCompleteRequest::class, ['successful' => false], ['successful' => false],
+        ];
+        yield 'successful backup keeps numeric predicate representation' => [
+            ReportBackupCompleteRequest::class,
+            ['successful' => true, 'checksum' => 'abc', 'checksum_type' => 'sha256', 'size' => '1024'],
+            ['successful' => true, 'checksum' => 'abc', 'checksum_type' => 'sha256', 'size' => '1024'],
+        ];
+        yield 'backup parts project only validated keys' => [
+            ReportBackupCompleteRequest::class,
+            ['successful' => false, 'parts' => [['etag' => 'part', 'part_number' => '1', 'extra' => 'discarded']]],
+            ['successful' => false, 'parts' => [['etag' => 'part', 'part_number' => '1']]],
+        ];
+    }
+
+    /** @param class-string<FormRequest> $requestClass */
+    #[DataProvider('acceptedExperimentalRequests')]
+    public function testExperimentalContractsMatchRuntime(string $requestClass, array $input, array $expected): void
+    {
+
+        $request = $this->validatedRequest($input, $requestClass);
+
+        static::assertSame($expected, $request->validated());
+        static::assertSame($expected, $request->safe()->all());
+        static::assertSame($input, $request->input());
+    }
+
+    /** @return iterable<string, array{class-string<FormRequest>, array<string, mixed>, string}> */
+    public static function rejectedExperimentalRequests(): iterable
+    {
+        yield 'present rejects omission' => [PresentModeRequest::class, ['mode' => 'create'], 'value'];
+        yield 'missing rejects a value' => [
+            MissingModeRequest::class, ['mode' => 'create', 'value' => 'forbidden', 'retained' => 'keep'], 'value',
+        ];
+        yield 'missing rejects null' => [
+            MissingModeRequest::class, ['mode' => 'create', 'value' => null, 'retained' => 'keep'], 'value',
+        ];
+        yield 'missing rejects an empty string' => [
+            MissingModeRequest::class, ['mode' => 'create', 'value' => '', 'retained' => 'keep'], 'value',
+        ];
+        yield 'mixed matching branch requires presence' => [MixedModeRequest::class, ['mode' => 'create'], 'value'];
+        yield 'controller domain is enforced' => [
+            PresentModeRequest::class, ['mode' => 'delete', 'value' => 'chosen'], 'mode',
+        ];
+        yield 'successful backup requires metadata' => [ReportBackupCompleteRequest::class, ['successful' => true], 'checksum'];
+        yield 'backup part requires its etag' => [
+            ReportBackupCompleteRequest::class, ['successful' => false, 'parts' => [['part_number' => '1']]], 'parts.0.etag',
+        ];
+    }
+
+    /** @param class-string<FormRequest> $requestClass */
+    #[DataProvider('rejectedExperimentalRequests')]
+    public function testExperimentalContractsRejectTheOppositeShape(string $requestClass, array $input, string $field): void
+    {
+
+        try {
+            $this->validatedRequest($input, $requestClass);
+            static::fail('A request violating its conditional contract was accepted.');
+        } catch (ValidationException $exception) {
+            static::assertArrayHasKey($field, $exception->errors());
+        }
+    }
+
+    /**
+     * @template T of FormRequest
+     *
+     * @param array<string, mixed> $input
+     * @param class-string<T> $requestClass
+     *
+     * @return T
+     */
+    private function validatedRequest(array $input, string $requestClass = GetDeployableNodesRequest::class): FormRequest
+    {
+        $user = new User();
+        $token = new ApiKey();
+        $token->key_type = ApiKey::TYPE_ACCOUNT;
+        $user->withAccessToken($token);
+
+        $request = $requestClass::create('/audit/experimental-validation', 'GET', $input);
+        $request->setContainer($this->app);
+        $request->setRedirector($this->app->make('redirect'));
+        $request->setUserResolver(static fn (): User => $user);
+        $request->validateResolved();
+
+        return $request;
+    }
+}
