+<?php
+
+namespace Tests\Feature;
+
+use Composer\InstalledVersions;
+use Illuminate\Foundation\Bootstrap\HandleExceptions;
+use jbboehr\PhpstanLaravelValidation\Validation\LaravelVersionContext;
+use PHPStan\Testing\TypeInferenceTestCase;
+
+final class ExperimentalInferenceTest extends TypeInferenceTestCase
+{
+    public static function getAdditionalConfigFiles(): array
+    {
+        $control = getenv('PLV_CONDITIONAL_CONTROL') === 'off' ? '-control' : '';
+
+        return [
+            dirname(__DIR__, 2) . '/phpstan-experimental' . $control . '.neon',
+            dirname(__DIR__) . '/Type/phpstan.neon',
+        ];
+    }
+
+    public function testExperimentalTypes(): void
+    {
+        static::assertSame(
+            ltrim(InstalledVersions::getPrettyVersion('laravel/framework'), 'v'),
+            self::getContainer()->getByType(LaravelVersionContext::class)->getVersion(),
+        );
+        $assertions = self::gatherAssertTypes(dirname(__DIR__) . '/Type/ExperimentalValidation.php');
+        static::assertNotEmpty($assertions);
+
+        foreach ($assertions as $assertion) {
+            $this->assertFileAsserts(...$assertion);
+        }
+    }
+
+    protected function tearDown(): void
+    {
+        HandleExceptions::flushState($this);
+        parent::tearDown();
+    }
+}
