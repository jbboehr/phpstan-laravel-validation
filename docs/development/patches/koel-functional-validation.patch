diff --git a/tests/Feature/ParsingAdoptionTest.php b/tests/Feature/ParsingAdoptionTest.php
new file mode 100644
index 0000000..5da3f54
--- /dev/null
+++ b/tests/Feature/ParsingAdoptionTest.php
@@ -0,0 +1,250 @@
+<?php
+
+namespace Tests\Feature;
+
+use App\Enums\DownloadableType;
+use App\Http\Controllers\API\RateSongController;
+use App\Http\Requests\API\RateRequest;
+use App\Http\Requests\Download\CheckDownloadableCountRequest;
+use App\Models\Contracts\Rateable;
+use App\Models\Song;
+use App\Models\User;
+use App\Repositories\SongRepository;
+use App\Services\RatingService;
+use Illuminate\Auth\Access\Response;
+use Illuminate\Contracts\Console\Kernel;
+use Illuminate\Database\Eloquent\Model;
+use Illuminate\Foundation\Application;
+use Illuminate\Foundation\Http\FormRequest;
+use Illuminate\Foundation\Testing\TestCase;
+use Illuminate\Validation\ValidationException;
+use PHPUnit\Framework\Attributes\DataProvider;
+use Tests\Fixtures\ExperimentalValidation\MissingModeRequest;
+use Tests\Fixtures\ExperimentalValidation\MixedModeRequest;
+use Tests\Fixtures\ExperimentalValidation\PresentModeRequest;
+
+final class ParsingAdoptionTest extends TestCase
+{
+    public function createApplication(): Application
+    {
+        $app = require dirname(__DIR__, 2) . '/bootstrap/app.php';
+        $app->make(Kernel::class)->bootstrap();
+
+        return $app;
+    }
+
+    /** @return iterable<string, array{mixed, int}> */
+    public static function acceptedRatings(): iterable
+    {
+        yield 'lower boundary' => ['0', 0];
+        yield 'ordinary rating' => ['3', 3];
+        yield 'upper boundary' => ['5', 5];
+        yield 'native integer' => [3, 3];
+    }
+
+    #[DataProvider('acceptedRatings')]
+    public function testValidatedRatingsAreIntegersWhileInputIsPreserved(mixed $rating, int $expected): void
+    {
+        $request = $this->validatedRequest(['rating' => $rating]);
+
+        static::assertSame(['rating' => $expected], $request->validated());
+        static::assertSame($expected, $request->validated('rating'));
+        static::assertSame(['rating' => $expected], $request->safe()->only(['rating']));
+        static::assertSame($rating, $request->input('rating'));
+        static::assertSame(['rating' => $rating], $request->input());
+    }
+
+    public function testSongConsumerReadsParsedValidatedRating(): void
+    {
+        $request = $this->validatedRequest(['rating' => '3']);
+        $ratingService = new class extends RatingService {
+            public mixed $receivedRating = null;
+
+            public function setRating(Rateable&Model $rateable, User $user, mixed $rating): void
+            {
+                $this->receivedRating = $rating;
+            }
+        };
+        $songRepository = $this->createMock(SongRepository::class);
+        $song = new Song();
+        $user = new User();
+        $songRepository->method('getOne')->willReturn($song);
+        $controller = new class($ratingService, $songRepository) extends RateSongController {
+            public function authorize(mixed $ability, mixed $arguments = []): Response
+            {
+                return Response::allow();
+            }
+        };
+
+        $controller($request, $song, $user);
+
+        static::assertSame(3, $ratingService->receivedRating);
+    }
+
+    /** @return iterable<string, array{array<string, mixed>}> */
+    public static function rejectedRatings(): iterable
+    {
+        yield 'missing' => [[]];
+        yield 'null' => [['rating' => null]];
+        yield 'below minimum' => [['rating' => '-1']];
+        yield 'above maximum' => [['rating' => '6']];
+        yield 'leading zero' => [['rating' => '03']];
+        yield 'explicit plus sign' => [['rating' => '+3']];
+        yield 'padded string' => [['rating' => ' 3']];
+        yield 'float' => [['rating' => 3.0]];
+        yield 'boolean' => [['rating' => true]];
+        yield 'array' => [['rating' => [3]]];
+    }
+
+    #[DataProvider('rejectedRatings')]
+    public function testRejectsInvalidOrNonCanonicalRatings(array $input): void
+    {
+        try {
+            $this->validatedRequest($input);
+            static::fail('Invalid rating was accepted.');
+        } catch (ValidationException $exception) {
+            static::assertArrayHasKey('rating', $exception->errors());
+        }
+    }
+
+    /** @return iterable<string, array{class-string<FormRequest>, array<string, mixed>, array<string, mixed>}> */
+    public static function acceptedExperimentalRequests(): iterable
+    {
+        yield 'definite presence' => [
+            PresentModeRequest::class,
+            ['mode' => 'create', 'value' => 'chosen', 'extra' => 'discarded'],
+            ['mode' => 'create', 'value' => 'chosen'],
+        ];
+        yield 'present permits an empty string' => [
+            PresentModeRequest::class,
+            ['mode' => 'create', 'value' => ''],
+            ['mode' => 'create', 'value' => ''],
+        ];
+        yield 'definite absence preserves later siblings' => [
+            MissingModeRequest::class,
+            ['mode' => 'create', 'retained' => 'keep'],
+            ['mode' => 'create', 'retained' => 'keep'],
+        ];
+        yield 'mixed domain matching branch' => [
+            MixedModeRequest::class,
+            ['mode' => 'create', 'value' => 'chosen'],
+            ['mode' => 'create', 'value' => 'chosen'],
+        ];
+        yield 'mixed domain nonmatching omission' => [
+            MixedModeRequest::class,
+            ['mode' => 'update'],
+            ['mode' => 'update'],
+        ];
+        yield 'mixed domain nonmatching value' => [
+            MixedModeRequest::class,
+            ['mode' => 'update', 'value' => 'optional'],
+            ['mode' => 'update', 'value' => 'optional'],
+        ];
+        yield 'download enum with no conditional target' => [
+            CheckDownloadableCountRequest::class,
+            ['type' => 'favorites'],
+            ['type' => 'favorites'],
+        ];
+        yield 'download enum case keeps its representation' => [
+            CheckDownloadableCountRequest::class,
+            ['type' => DownloadableType::Favorites],
+            ['type' => DownloadableType::Favorites],
+        ];
+        $downloadType = new class implements \Stringable {
+            public function __toString(): string
+            {
+                return 'favorites';
+            }
+        };
+        yield 'download stringable keeps its representation' => [
+            CheckDownloadableCountRequest::class,
+            ['type' => $downloadType],
+            ['type' => $downloadType],
+        ];
+        yield 'song download requires its list' => [
+            CheckDownloadableCountRequest::class,
+            ['type' => 'songs', 'ids' => ['first', 'second']],
+            ['type' => 'songs', 'ids' => ['first', 'second']],
+        ];
+        yield 'album download retains raw identifier' => [
+            CheckDownloadableCountRequest::class,
+            ['type' => 'album', 'id' => '21'],
+            ['type' => 'album', 'id' => '21'],
+        ];
+    }
+
+    /** @param class-string<FormRequest> $requestClass */
+    #[DataProvider('acceptedExperimentalRequests')]
+    public function testExperimentalContractsMatchRuntime(string $requestClass, array $input, array $expected): void
+    {
+        $this->app['config']->set('koel.download.allow', true);
+
+        $request = $this->validatedRequest($input, $requestClass);
+
+        static::assertSame($expected, $request->validated());
+        static::assertSame($expected, $request->safe()->all());
+        static::assertSame($input, $request->input());
+    }
+
+    /** @return iterable<string, array{class-string<FormRequest>, array<string, mixed>, string}> */
+    public static function rejectedExperimentalRequests(): iterable
+    {
+        yield 'present rejects omission' => [PresentModeRequest::class, ['mode' => 'create'], 'value'];
+        yield 'missing rejects a value' => [
+            MissingModeRequest::class,
+            ['mode' => 'create', 'value' => 'forbidden', 'retained' => 'keep'],
+            'value',
+        ];
+        yield 'missing rejects null' => [
+            MissingModeRequest::class,
+            ['mode' => 'create', 'value' => null, 'retained' => 'keep'],
+            'value',
+        ];
+        yield 'missing rejects an empty string' => [
+            MissingModeRequest::class,
+            ['mode' => 'create', 'value' => '', 'retained' => 'keep'],
+            'value',
+        ];
+        yield 'mixed matching branch requires presence' => [MixedModeRequest::class, ['mode' => 'create'], 'value'];
+        yield 'controller domain is enforced' => [
+            PresentModeRequest::class,
+            ['mode' => 'delete', 'value' => 'chosen'],
+            'mode',
+        ];
+        yield 'song download rejects missing ids' => [CheckDownloadableCountRequest::class, ['type' => 'songs'], 'ids'];
+        yield 'album download rejects missing id' => [CheckDownloadableCountRequest::class, ['type' => 'album'], 'id'];
+    }
+
+    /** @param class-string<FormRequest> $requestClass */
+    #[DataProvider('rejectedExperimentalRequests')]
+    public function testExperimentalContractsRejectTheOppositeShape(
+        string $requestClass,
+        array $input,
+        string $field,
+    ): void {
+        $this->app['config']->set('koel.download.allow', true);
+
+        try {
+            $this->validatedRequest($input, $requestClass);
+            static::fail('A request violating its conditional contract was accepted.');
+        } catch (ValidationException $exception) {
+            static::assertArrayHasKey($field, $exception->errors());
+        }
+    }
+
+    /**
+     * @template T of FormRequest
+     * @param array<string, mixed> $input
+     * @param class-string<T> $requestClass
+     * @return T
+     */
+    private function validatedRequest(array $input, string $requestClass = RateRequest::class): FormRequest
+    {
+        $request = $requestClass::create('/audit/experimental-validation', 'PUT', $input);
+        $request->setContainer($this->app);
+        $request->setRedirector($this->app->make('redirect'));
+        $request->validateResolved();
+
+        return $request;
+    }
+}
