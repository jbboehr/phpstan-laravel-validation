@@ -0,0 +1,33 @@
+<?php
+
+declare(strict_types=1);
+
+use App\Http\Requests\API\RateRequest;
+use App\Http\Requests\Download\CheckDownloadableCountRequest;
+use Tests\Fixtures\ExperimentalValidation\MissingModeRequest;
+use Tests\Fixtures\ExperimentalValidation\MixedModeRequest;
+use Tests\Fixtures\ExperimentalValidation\PresentModeRequest;
+
+use function PHPStan\Testing\assertType;
+
+function experimental_validation_contracts(
+    PresentModeRequest $present,
+    MissingModeRequest $missing,
+    MixedModeRequest $mixed,
+    RateRequest $parsed,
+    CheckDownloadableCountRequest $natural,
+): void {
+    assertType("array{mode: 'create', value: string}", $present->validated());
+    assertType('array{value: string}', $present->safe()->only(['value']));
+    assertType("array{mode: 'create', retained: string}", $missing->validated());
+    assertType('array{}', $missing->safe()->only(['value']));
+    assertType("array{mode: 'create'|'update', value?: string}", $mixed->validated());
+    assertType('mixed', $present->input('value'));
+    assertType('int', $parsed->validated('rating'));
+    assertType('array{rating: int}', $parsed->safe()->only(['rating']));
+    assertType(
+        "array{type: 'album'|'artist'|'favorites'|'playlist'|'songs'|App\\Enums\\DownloadableType::Album|App\\Enums\\DownloadableType::Artist|App\\Enums\\DownloadableType::Favorites|App\\Enums\\DownloadableType::Playlist|App\\Enums\\DownloadableType::Songs|Stringable}",
+        $natural->safe()->only(['type']),
+    );
+    assertType('array{ids?: array|string}', $natural->safe()->only(['ids']));
+}
