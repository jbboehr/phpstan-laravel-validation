includes:
    - vendor/phpstan/phpstan/conf/bleedingEdge.neon
    - vendor/phpstan/phpstan-phpunit/extension.neon
    - vendor/phpstan/phpstan-phpunit/rules.neon
    - vendor/phpstan/phpstan-strict-rules/rules.neon
    - extension.neon
parameters:
    stubFiles:
        # The development lock uses Laravel 10; version-pinned fixtures exercise
        # the Rule::array() factory introduced in Laravel 11.7.
        - tests/stubs/LaravelRuleArray.stub
    level: max
    paths:
        - src
        - scripts/valid-test-extractor-functions.php
        - tests
    excludePaths:
        - tests/fixtures
        - tests/larastan
        - tests/normalized
        - tests/custom-rules
        - tests/form-request
        - tests/rules
        - tests/structure
        - tests/version-aware
