includes:
    - vendor/phpstan/phpstan/conf/bleedingEdge.neon
    - vendor/phpstan/phpstan-phpunit/extension.neon
    - vendor/phpstan/phpstan-phpunit/rules.neon
    - vendor/phpstan/phpstan-strict-rules/rules.neon
    - vendor/jbboehr/doctrine-of-the-second-sun/integrations/phpstan/extension.neon
    - phpstan-logion-baseline.neon
    - extension.neon
parameters:
    doctrineOfTheSecondSun:
        enabled: true
        filePatterns:
            - '#/src/#'
        checkClassLikes: true
        checkMethods: false
        checkFunctions: false
    stubFiles:
        # The development lock uses Laravel 10; version-pinned fixtures exercise
        # Rule factories introduced in later Laravel releases.
        - tests/stubs/LaravelRuleArray.stub
    level: max
    paths:
        - runtime
        - src
        - scripts/benchmark-bookstack.php
        - scripts/benchmark-form-requests.php
        - scripts/valid-test-extractor-functions.php
        - tests
    excludePaths:
        - tests/fixtures
        - tests/larastan
        - tests/normalized
        - tests/parsing
        - tests/custom-rules
        - tests/conditional-presence
        - tests/form-request
        - tests/include-unvalidated-array-keys
        - tests/rules
        - tests/structure
        - tests/version-aware
