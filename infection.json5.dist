{
    "$schema": "./tools/infection/vendor/infection/infection/resources/schema.json",
    "source": {
        "directories": [
            "src"
        ]
    },
    // PHPStan fixture tests run analyzer work in-process and can take
    // materially longer on shared CI runners than they do locally.
    "timeout": 60,
    "threads": 4,
    "minMsi": 50,
    "minCoveredMsi": 80,
    "timeoutsAsEscaped": true,
    "maxTimeouts": 10,
    // Out-of-process integration tests cannot observe the active in-process
    // mutant. Keep them in the normal suite, but do not spend mutation-test
    // time running child PHPStan processes that provide no mutation evidence.
    // Property tests also remain in the normal suite, while focused regressions
    // promoted from their findings provide mutation evidence without replaying
    // hundreds of generated cases for each mutant.
    "testFrameworkExtraArgs": "--exclude-group=subprocess,property,documentation",
    "logs": {
        "text": "infection.log",
        "summary": "infection-summary.log"
    },
    "mutators": {
        "@default": true,
        // These mutations violate resolvePath()'s progress invariant: every
        // recursive call must receive a shorter key. They otherwise recurse
        // until PHP exhausts memory or the native stack. A timeout cannot
        // contain a SIGSEGV, so ignore only the non-progressing mutations.
        "GreaterThan": {
            "ignoreSourceCodeByRegex": [
                ".*PREG_OFFSET_CAPTURE\\) > 0\\) \\{"
            ]
        },
        "GreaterThanNegotiation": {
            "ignoreSourceCodeByRegex": [
                ".*PREG_OFFSET_CAPTURE\\) > 0\\) \\{"
            ]
        },
        "Plus": {
            "ignoreSourceCodeByRegex": [
                ".*matches\\[0\\]\\[1\\] \\+ 1;",
                ".*remainder = substr.*pos \\+ 1.*"
            ]
        },
        "UnwrapSubstr": {
            "ignoreSourceCodeByRegex": [
                ".*remainder = substr.*pos \\+ 1.*"
            ]
        }
    },
    "testFramework": "phpunit"
}
