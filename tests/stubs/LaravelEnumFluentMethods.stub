declare(strict_types=1);

namespace Illuminate\Validation\Rules;

/**
 * Test-only declarations for the fluent methods added to Laravel's Enum rule
 * in 10.46. Version-pinned fixtures must be analyzable when the test matrix has
 * an older Laravel 10 release installed; the configured Laravel version still
 * decides whether the extension interprets these methods.
 *
 * @method $this only(\UnitEnum|array<\UnitEnum> $values)
 * @method $this except(\UnitEnum|array<\UnitEnum> $values)
 * @method $this when(mixed $value = null, ?callable $callback = null, ?callable $default = null)
 * @method $this unless(mixed $value = null, ?callable $callback = null, ?callable $default = null)
 */
class Enum
{
}
