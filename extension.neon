parameters:
  stubFiles:
    - stubs/Validator.stub
  phpstanLaravelValidation:
    assumeHttpInputNormalization: false
    includeUnvalidatedArrayKeys: false
    laravelVersion: auto
    formRequests:
      enabled: false
      trustedClasses: []
    customRules:
      classes: []
      names: []

parametersSchema:
  phpstanLaravelValidation: structure([
    assumeHttpInputNormalization: bool(),
    includeUnvalidatedArrayKeys: bool(),
    laravelVersion: string(),
    formRequests: structure([
      enabled: bool(),
      trustedClasses: arrayOf(string())
    ]),
    customRules: structure([
      classes: arrayOf(string()),
      names: arrayOf(string())
    ])
  ])

services:
  - class: jbboehr\PhpstanLaravelValidation\Evaluator\UnsafeConstExprEvaluator
  - class: jbboehr\PhpstanLaravelValidation\Validation\CustomRuleTypeResolver
    arguments:
      configuredClasses: %phpstanLaravelValidation.customRules.classes%
      configuredNames: %phpstanLaravelValidation.customRules.names%
  - class: jbboehr\PhpstanLaravelValidation\Validation\RuleParameterExpressionResolver
  - class: jbboehr\PhpstanLaravelValidation\Validation\EnumRuleExpressionResolver
  - class: jbboehr\PhpstanLaravelValidation\Validation\InRuleExpressionResolver
  - class: jbboehr\PhpstanLaravelValidation\Validation\NotInRuleExpressionResolver
  - class: jbboehr\PhpstanLaravelValidation\Validation\ArrayRuleExpressionResolver
  - class: jbboehr\PhpstanLaravelValidation\Validation\ArrayKeysRuleExpressionResolver
  - class: jbboehr\PhpstanLaravelValidation\Validation\NumericRuleExpressionResolver
  - class: jbboehr\PhpstanLaravelValidation\Validation\StringRuleExpressionResolver
  - class: jbboehr\PhpstanLaravelValidation\Validation\RuleSetResolver
  - class: jbboehr\PhpstanLaravelValidation\Validation\FormRequestRuleTypeResolver
    arguments:
      parser: @currentPhpVersionSimpleDirectParser
      assumeHttpInputNormalization: %phpstanLaravelValidation.assumeHttpInputNormalization%
  - class: jbboehr\PhpstanLaravelValidation\Validation\FormRequestTypeRegistry
    arguments:
      parser: @currentPhpVersionSimpleDirectParser
      workingDirectory: %currentWorkingDirectory%
      tmpDirectory: %tmpDir%
      enabled: %phpstanLaravelValidation.formRequests.enabled%
      trustedClasses: %phpstanLaravelValidation.formRequests.trustedClasses%
      analysedPaths: %analysedPaths%
      analysedPathsFromConfig: %analysedPathsFromConfig%
      composerAutoloaderProjectPaths: %composerAutoloaderProjectPaths%
      scanFiles: %scanFiles%
      scanDirectories: %scanDirectories%
    tags:
      - phpstan.resultCacheMetaExtension
  - class: jbboehr\PhpstanLaravelValidation\Validation\LaravelVersionContext
    arguments:
      workingDirectory: %currentWorkingDirectory%
      configuredVersion: %phpstanLaravelValidation.laravelVersion%
    tags:
      - phpstan.resultCacheMetaExtension
  - class: jbboehr\PhpstanLaravelValidation\Validation\TypeResolver
    arguments:
      includeUnvalidatedArrayKeys: %phpstanLaravelValidation.includeUnvalidatedArrayKeys%
  - class: jbboehr\PhpstanLaravelValidation\Type\ValidatorTypeHelper
  - class: jbboehr\PhpstanLaravelValidation\Extension\CallArgumentResolver
  - class: jbboehr\PhpstanLaravelValidation\Rule\UnvalidatedArrayKeysConfigurationRule
    arguments:
      includeUnvalidatedArrayKeys: %phpstanLaravelValidation.includeUnvalidatedArrayKeys%
    tags:
      - phpstan.rules.rule
  - class: jbboehr\PhpstanLaravelValidation\Extension\ControllerValidateExtension
    arguments:
      assumeHttpInputNormalization: %phpstanLaravelValidation.assumeHttpInputNormalization%
    tags:
      - phpstan.broker.dynamicMethodReturnTypeExtension
  - class: jbboehr\PhpstanLaravelValidation\Extension\ControllerValidateWithExtension
    tags:
      - phpstan.broker.dynamicMethodReturnTypeExtension
  - class: jbboehr\PhpstanLaravelValidation\Extension\FacadeMakeExtension
    tags:
      - phpstan.broker.dynamicStaticMethodReturnTypeExtension
  - class: jbboehr\PhpstanLaravelValidation\Extension\FacadeValidateExtension
    tags:
      - phpstan.broker.dynamicStaticMethodReturnTypeExtension
  - class: jbboehr\PhpstanLaravelValidation\Extension\FactoryMakeExtension
    tags:
      - phpstan.broker.dynamicMethodReturnTypeExtension
  - class: jbboehr\PhpstanLaravelValidation\Extension\FormRequestValidatedExtension
    tags:
      - phpstan.broker.dynamicMethodReturnTypeExtension
  - class: jbboehr\PhpstanLaravelValidation\Extension\RequestValidateExtension
    arguments:
      assumeHttpInputNormalization: %phpstanLaravelValidation.assumeHttpInputNormalization%
    tags:
      - phpstan.broker.dynamicMethodReturnTypeExtension
  - class: jbboehr\PhpstanLaravelValidation\Extension\ValidatorFunctionExtension
    tags:
      - phpstan.broker.dynamicFunctionReturnTypeExtension
  - class: jbboehr\PhpstanLaravelValidation\Extension\ValidatorSetRulesExtension
    tags:
      - phpstan.broker.dynamicMethodReturnTypeExtension
  - class: jbboehr\PhpstanLaravelValidation\Extension\ValidatorValidatedExtension
    tags:
      - phpstan.broker.dynamicMethodReturnTypeExtension
