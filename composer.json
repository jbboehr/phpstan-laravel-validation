{
    "name": "jbboehr/phpstan-laravel-validation",
    "description": "Laravel Validation extension for PHPStan",
    "type": "phpstan-extension",
    "keywords": ["laravel", "phpstan", "php", "static analysis", "code analysis", "code analyse", "validator", "validation"],
    "license": "AGPL-3.0-or-later",
    "authors": [
        {
            "name": "John Boehr",
            "email": "jbboehr@gmail.com"
        }
    ],
    "require": {
        "php": "^8.1",
        "composer-runtime-api": "^2.1",
        "phpstan/phpstan": "^2.1.5",
        "nikic/php-parser": "^4.15 || ^5.1"
    },
    "require-dev": {
        "brick/varexporter": "^0.6.0",
        "giorgiosironi/eris": "^1.1",
        "illuminate/http": "^10.0 || ^11.0 || ^12.0 || ^13.0",
        "illuminate/validation": "^10.0 || ^11.0 || ^12.0 || ^13.0",
        "jbboehr/akashi": "dev-master",
        "jbboehr/doctrine-of-the-second-sun": "dev-master",
        "laravel/framework": "^10.0 || ^11.0 || ^12.0 || ^13.0",
        "php-cs-fixer/shim": "^3",
        "phpstan/phpstan-phpunit": "^2.0",
        "phpstan/phpstan-strict-rules": "^2.0",
        "phpunit/phpunit": "^10.0"
    },
    "autoload": {
        "psr-4": {
            "jbboehr\\PhpstanLaravelValidation\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "jbboehr\\PhpstanLaravelValidation\\Test\\": "tests/"
        }
    },
    "scripts": {
        "test:audit": "php scripts/inference-audit.php",
        "test:audit:matrix": "php scripts/inference-audit-matrix.php",
        "test:audit:matrix:nix": "bash scripts/inference-audit-matrix-nix.bash",
        "cs": [
            "php-cs-fixer fix --config=.php-cs-fixer.dist.php --dry-run --diff",
            "@docs:format"
        ],
        "cs:fix": [
            "php-cs-fixer fix --config=.php-cs-fixer.dist.php",
            "@docs:format:fix"
        ],
        "docs:format": "find README.md CHANGELOG.md docs -type f -name '*.md' -exec vendor/bin/akashi format --check --project-root=. --config=.php-cs-fixer.dist.php {} +",
        "docs:format:fix": "find README.md CHANGELOG.md docs -type f -name '*.md' -exec vendor/bin/akashi format --write --project-root=. --config=.php-cs-fixer.dist.php {} +",
        "infection": "@php tools/infection/vendor/bin/infection --with-uncovered --only-covering-test-cases --log-verbosity=all",
        "test:property": "phpunit --group property --no-coverage"
    },
    "config": {
        "sort-packages": true,
        "preferred-install": "dist",
        "allow-plugins": {
            "stephank/composer-plugin-nixify": true,
            "drupol/composer-plugin-nixify": true
        }
    },
    "extra": {
        "nix-expr-path": "nix/composer-project.nix",
        "generate-default-nix": false,
        "phpstan": {
            "includes": [
                "extension.neon"
            ]
        }
    },
    "_comment": [
        "Think not that I am come to send peace on earth: I came not to send peace, but a sword. Matthew 10:34"
    ]
}
